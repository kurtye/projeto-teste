/**
 * @fileoverview Firestore Security Rules for the Hell Let Loose BR application.
 *
 * Core Philosophy:
 * This ruleset prioritizes public data availability while strictly controlling write access.
 * Read access is open to all, as the data is public. Write access is restricted to backend processes
 * (simulated by denying all client-side writes) to ensure data integrity.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // This collection is for backend processing only. No client access.
    match /rawMatchResults/{matchId} {
      allow read, write: if false;
    }

    // This collection holds public global stats. Allow anyone to read.
    match /globalStats/{docId} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // This collection and its subcollections hold public player data.
    // Allow anyone to read, but no one to write.
    match /playerAggregates/{playerId}/{document=**} {
      allow get, list: if true;
      allow write: if false;
    }
  }
}
